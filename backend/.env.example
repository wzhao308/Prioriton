# PRIORITON_SECRET_KEY is optional - leave it unset and the app will
# generate one automatically into your OS's credential store (Windows
# Credential Manager / macOS Keychain / Linux Secret Service) the first time
# it's needed, and reuse it from there after that. This keeps the key out of
# this file - useful if this project folder is itself synced somewhere
# (OneDrive, Dropbox, ...), since that sync has nothing to do with git and
# ignores .gitignore entirely.
#
# Only set this if you'd rather manage the key yourself (e.g. Docker/CI,
# where there's usually no OS keyring available):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIORITON_SECRET_KEY=

PRIORITON_DB_PATH=./prioriton.db
PRIORITON_SYNC_INTERVAL_MINUTES=15
PRIORITON_RECOMMENDATION_CHECK_INTERVAL_HOURS=24
PRIORITON_RECOMMENDATION_PERIOD_DAYS=7
PRIORITON_FRONTEND_ORIGIN=http://localhost:5173

# Get one at https://console.anthropic.com/ - required for the AI
# Recommendation System. Everything else works fine without it.
ANTHROPIC_API_KEY=
