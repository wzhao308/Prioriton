# Copy this file to `.env` in this same directory before running
# `docker compose up`. `.env` (not this file) is what Compose loads
# automatically - both for build-time args (the frontend's API URL) and
# each container's runtime environment. The real `.env` is gitignored;
# this example file is the only one meant to be committed.

# app.<DOMAIN>, api.<DOMAIN>, and vnc.<DOMAIN> all need a DNS A record
# pointing at this server's public IP before you bring the stack up, or
# Caddy's automatic HTTPS (Let's Encrypt) can't issue certificates for them.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# HTTP Basic Auth in front of all three subdomains (app/api/vnc) - this is
# the entire access control for this deploy; there's no separate login
# inside the app itself. Pick a real password, then hash it (the Caddyfile
# needs the hash, never the plaintext):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password-here'
#
# IMPORTANT: bcrypt hashes are full of literal `$` characters (they look
# like $2a$14$abc...), and Docker Compose treats `$` in a .env file as the
# start of ITS OWN variable substitution syntax - paste the hash in with
# every single `$` doubled to `$$`, or Compose will silently mangle it into
# something else and Basic Auth just won't work. Example: a hash of
# $2a$14$abc becomes $$2a$$14$$abc here.
BASIC_AUTH_USER=you
BASIC_AUTH_HASH=

# Required here - unlike local dev, there's no OS keyring inside a container
# for app.security.get_or_create_secret_key() to fall back to, so this has
# to be set explicitly. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIORITON_SECRET_KEY=

# Optional - the AI Recommendation System just stays unconfigured without
# it; everything else works fine.
ANTHROPIC_API_KEY=
