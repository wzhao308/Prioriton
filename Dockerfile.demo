# The public-demo image: frontend + backend in ONE container, no browser
# automation at all - Gradescope/PrairieLearn connecting is disabled in demo
# mode (see app/routers/integrations.py's _reject_in_demo_mode), so this
# skips Playwright's Chromium download and the whole Xvfb/noVNC chain
# backend/Dockerfile needs for the real VPS deploy. Much smaller, much
# simpler, and there's nothing sensitive in it to protect.
#
# Built from the project root (not backend/), since it needs both backend/
# and frontend/ in its build context - see DEPLOY_DEMO.md.

# Stage 1: build the frontend. Same-origin as the backend in this deploy
# shape, so VITE_API_BASE is just "/api" (relative - works under any domain)
# - and /api is exactly the prefix app/main.py mounts every router under
# whenever it finds a frontend build sitting next to it (this one), since
# several frontend page routes and backend API routes share a literal path
# otherwise (GET /courses, /settings, /recommendations are both a page and
# an endpoint) - confirmed this collision for real before adding the prefix.
FROM node:20-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend .
ENV VITE_API_BASE="/api"
RUN npm run build

# Stage 2: the backend, with the built frontend baked in at frontend_dist/
# (app.main.FRONTEND_DIST_DIR - that's what makes it get served at all).
FROM python:3.12-slim
WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
COPY backend/scripts ./scripts
COPY --from=frontend-build /frontend/dist ./frontend_dist

ENV PRIORITON_DEMO_MODE=true \
    PRIORITON_DB_PATH=/data/prioriton.db \
    PYTHONUNBUFFERED=1

RUN mkdir -p /data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
